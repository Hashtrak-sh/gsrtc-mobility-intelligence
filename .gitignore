.venv/
__pycache__/
*.pyc
.env
data/raw/video/
*.mp4
*.mov
*.avi
*.pt

# --- M0 additions ---
venv/
.env.*
!.env.example
.pytest_cache/
.streamlit/secrets.toml
*.egg-info/

# Generated data: one command regenerates it (python -m modules.data_gen.generate)
data/synthetic/*
!data/synthetic/.gitkeep
!data/synthetic/planted_findings.md
data/processed/*
!data/processed/.gitkeep
# Cached OSM downloads and other raw inputs are local only
data/raw/*
!data/raw/.gitkeep
*.onnx
*.mkv
*.webm

# --- M0 additions ---
venv/
.env.*
!.env.example
.pytest_cache/
.streamlit/secrets.toml
*.egg-info/
*.onnx
*.mkv
*.webm

# Generated data: one command regenerates it (python -m modules.data_gen.generate)
data/synthetic/*
!data/synthetic/.gitkeep
!data/synthetic/planted_findings.md
data/processed/*
!data/processed/.gitkeep
# Cached OSM downloads and other raw inputs are local only
data/raw/*
!data/raw/.gitkeep

# The small OSM place cache IS tracked so a fresh clone generates with real OSM coordinates (osmnx_cache/ stays ignored)
!data/raw/osm_places.parquet
!data/raw/osm_places.provenance.json
!data/raw/osm_graph_corridor.graphml
!data/raw/osm_graph_corridor.provenance.json
!data/raw/osm_graph_link_*.graphml
!data/raw/osm_graph_link_*.provenance.json

# --- M6-CCTV ---
.venv-cv/
data/processed/cctv/
*.pt
*.mp4
!modules/cv/configs/*.json

# --- M7 ---
data/processed/llm_cache/
data/processed/reports/

# --- Hosting (Streamlit Community Cloud) ---
# The hosted app has no data-preparation step, so the generated tables it reads (about 6 MB) are tracked.
# Regenerate locally with the commands in the README and commit the result to refresh the hosted data.
!data/synthetic/*.parquet
!data/synthetic/*.provenance.json
!data/processed/*.parquet
!data/processed/*.provenance.json
!data/processed/cctv_spot_check.json
# Only the short browser-playable CCTV excerpt is tracked; the full annotated clip (about 500 MB) and the weights stay local
!data/processed/cctv/
data/processed/cctv/*
!data/processed/cctv/*_excerpt.mp4
!data/processed/cctv/*_excerpt.json
